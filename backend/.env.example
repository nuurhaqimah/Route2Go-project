# Copy this file to .env and fill in your own values
# cp .env.example .env

# --- Google Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- PostgreSQL Database ---
DB_NAME=itinerary_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432

# --- Flask ---
FLASK_SECRET_KEY=change_this_to_a_long_random_string

# Port the dev server binds. Defaults to 5000, but Windows often reserves 5000
# (check with: netsh interface ipv4 show excludedportrange protocol=tcp), so
# 5050 is a safer default there.
PORT=5050

# --- Admin Panel ---
ADMIN_USER=admin
ADMIN_PASS=change_this_password
